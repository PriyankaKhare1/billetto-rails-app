<style>
  .auth-container { max-width: 400px; margin: 3rem auto; text-align: center; }
  .auth-box { background: #fff; padding: 2rem; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.1); }
  .auth-title { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; }
  .auth-subtitle { color: #666; margin-bottom: 2rem; font-size: 0.9rem; }
  #clerk-sign-in { min-height: 400px; }
</style>

<div class="auth-container">
  <div class="auth-box">
    <h1 class="auth-title">Sign In</h1>
    <p class="auth-subtitle">Sign in to vote on events</p>
    <div id="clerk-sign-in"></div>
  </div>
</div>

<script>
  function mountClerkSignIn() {
    if (window.clerkReady) {
      window.clerkReady.then(function(clerk) { clerk.mountSignIn(document.getElementById("clerk-sign-in"), {
        afterSignInUrl: window.location.origin,
        afterSignUpUrl: window.location.origin,
        routing: "path",
        path: "/sign_in"
      }); }).catch(function(error) { console.error('Could not mount Clerk sign-in:', error); });
    } else {
      setTimeout(mountClerkSignIn, 100);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountClerkSignIn);
  } else {
    mountClerkSignIn();
  }
</script>
